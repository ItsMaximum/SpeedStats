# Copy to .env for local development. Nothing here is required to run `npm run dev` with the fixture DB.

# Where published DuckDB files, the CURRENT pointer and crawl work files live.
DATA_DIR=./data

# --- scraper ---
# Comma-separated Heroku app names of the cors-anywhere proxies (https://<app>.herokuapp.com/). Leave empty to hit
# speedrun.com directly (only for small --only-game / --only-series runs).
SRC_PROXIES=
SRC_PER_PROXY_CONCURRENCY=2
SRC_MAX_ATTEMPTS=20
# speedrun.com ids to skip (comma-separated)
EXCLUDED_GAMES=w6jrzxdj
EXCLUDED_CATEGORIES=n2y350ed,5dw43j0k
# player names (as shown on speedrun.com) that asked to be excluded
EXCLUDED_PLAYERS=

# --- publish ---
MIN_LEADERBOARDS=600000
# where the scraper checks that the API picked up a new version (in docker compose: http://api:8000/health)
API_HEALTH_URL=http://localhost:8000/health
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=speedstats
PUBLIC_URL=https://speedstats.app
